# --- Sanity (content management) ---
# Project id from sanity.io/manage. Until set, the site renders seed content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the Studio → /api/revalidate webhook (any long random string).
SANITY_REVALIDATE_SECRET=

# --- Resend (contact form + newsletter) ---
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
CONTACT_TO_EMAIL=
# Optional until the sending domain is verified; defaults to onboarding@resend.dev.
CONTACT_FROM_EMAIL=

# --- Square (online checkout) ---
# "sandbox" or "production"; anything but "production" uses the sandbox.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# "true" shows Buy now; otherwise product pages use the email order request.
CHECKOUT_ENABLED=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
